*{box-sizing:border-box}body{color:#0f172a;background:linear-gradient(#67e8f9,#bae6fd,#a7f3d0);margin:0;font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,Segoe UI,sans-serif}button{cursor:pointer;font:inherit;border:0;font-weight:900}button:disabled{cursor:not-allowed;opacity:.4}.app-shell{max-width:1180px;min-height:100vh;margin:0 auto;padding:18px}header{justify-content:space-between;align-items:center;gap:16px;margin-bottom:16px;display:flex}h1{margin:0;font-size:clamp(30px,4vw,48px);font-weight:1000}h2{margin:0;font-size:30px}p{margin:.35rem 0}.button-row{flex-wrap:wrap;gap:10px;display:flex}.button-row button,header button,.map-controls button,.logic-head button,.logic-actions button,.side-card button{background:#fff;border-radius:18px;padding:12px 18px;box-shadow:0 4px 14px #0f172a24}button.primary,.primary{color:#0f172a;background:#facc15!important}.map-card,.logic-card{background:#fff;border:4px solid #111827;border-radius:28px;overflow:hidden;box-shadow:0 22px 60px #0f172a3d}.map-svg{background:#ffe08a;width:100%;height:auto;display:block}.clickable{cursor:pointer}.locked{cursor:not-allowed}.map-controls{background:#fff;justify-content:space-between;align-items:center;gap:12px;padding:14px;display:flex}.font-bold{font-weight:1000}.stage-wrap{grid-template-columns:1fr 280px;align-items:start;gap:16px;display:grid}.game-card{background:#1e3a8a;border:4px solid #facc15;border-radius:28px;position:relative;overflow:hidden;box-shadow:0 22px 60px #0f172a3d}.game-svg{width:100%;height:auto;display:block}.side-card{color:#fff;background:linear-gradient(#172554,#1e3a8a);border:2px solid #facc15;border-radius:28px;padding:18px;box-shadow:0 16px 34px #0f172a33}.side-card p{line-height:1.5}.touch-controls{pointer-events:none;justify-content:space-between;align-items:end;padding:12px;display:flex;position:absolute;bottom:0;left:0;right:0}.touch-controls div,.touch-controls .jump{pointer-events:auto}.touch-controls button{color:#fff;background:#1d4ed8f2;border:2px solid #a5f3fc;border-radius:999px;width:56px;height:56px;margin-right:8px;font-size:24px;box-shadow:0 10px 24px #0f172a4d}.touch-controls .jump{color:#172554;background:#facc15;border:4px solid #fff;width:82px;height:82px;font-size:15px}.logic-card{background:linear-gradient(#e0e7ff,#d1fae5)}.logic-head{background:#ffffffd9;border-bottom:4px solid #111827;justify-content:space-between;align-items:center;gap:14px;padding:20px;display:flex}.eyebrow{text-transform:uppercase;color:#64748b;letter-spacing:.05em;font-size:13px;font-weight:1000}.logic-grid{grid-template-columns:1fr 300px;gap:20px;padding:20px;display:grid}.logic-scene{background:#bae6fd;border:4px solid #075985;border-radius:24px;width:100%;display:block}.sequence{background:#fff;border:4px solid #111827;border-radius:24px;margin-top:14px;padding:14px}.slots{gap:12px;display:grid}.slot{background:#f1f5f9;border:4px dashed #cbd5e1;border-radius:22px;justify-content:center;align-items:center;min-height:76px;font-size:40px;font-weight:1000;display:flex}.logic-actions{grid-template-columns:1fr 1fr;align-content:start;gap:12px;display:grid}.logic-actions .full{grid-column:1/-1}.cards{grid-column:1/-1;grid-template-columns:1fr 1fr;gap:12px;display:grid}.cards button{background:#fff;border:4px solid #111827;border-radius:24px;min-height:78px;font-size:34px}.tangram-grid{grid-template-columns:1fr 300px;gap:20px;padding:20px;display:grid}.tangram-board{background:#fff;border:4px solid #581c87;border-radius:24px;grid-template-columns:1fr 1fr;gap:16px;padding:20px;display:grid}.tangram-board button{aspect-ratio:1;background:#faf5ff;border:4px dashed #8b5cf6;border-radius:24px;font-size:82px}.tangram-pieces{gap:12px;display:grid}.tangram-pieces button{background:#fff;border:4px solid #111827;border-radius:24px;padding:18px;font-size:56px}@media (width<=900px){header,.map-controls{flex-direction:column;align-items:stretch}.stage-wrap,.logic-grid,.tangram-grid{grid-template-columns:1fr}.side-card{order:2}.app-shell{padding:10px}.touch-controls{display:flex}}
